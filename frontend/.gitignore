# ============================================
# .gitignore - المنارة القرآنية
# ============================================
# الملفات والمجلدات المستبعدة من Git
# Generated by: Mavis (2026-09-03)
# ============================================

# Dependencies
# -----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Production build
# ----------------
# ملاحظة: build/ يتم تجاهله افتراضياً لأنه يولّد من npm run build
# إذا أردت تتبعه، احذف السطر التالي
build/
dist/

# Environment variables (تحتوي على secrets!)
# -------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE / Editor
# ------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
# ----
logs/
*.log

# Testing / Coverage
# ------------------
coverage/
.nyc_output/

# Misc
# ----
.eslintcache
.cache/
.parcel-cache/
