# يضمن توافق line endings بين Windows و Unix
# Generated by: Mavis (2026-09-03)
# ============================================

# تطبيع line endings على كل الملفات النصية
* text=auto eol=lf

# ملفات المصدر في Windows: CRLF
*.js      text eol=crlf
*.jsx     text eol=crlf
*.css     text eol=crlf
*.html    text eol=crlf
*.json    text eol=crlf
*.md      text eol=lf
*.sql     text eol=lf

# ملفات ثنائية
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.woff    binary
*.woff2   binary
